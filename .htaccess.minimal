# Minimal, maximally-compatible protection.
# Use this if the full .htaccess returns HTTP 500 on your host.
# It contains no Options and no mod_rewrite — only file denies.

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|sqlite|bak|bak2|log|zip|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
