

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# --- BEGIN hardening -------------------------------------------------------
# Secrets, database dumps and local artefacts must never be served. Without
# this, /.env returns every credential the application holds.

# Dotfiles: .env, .env.example, .git*, .installed, .setup-token, .htpasswd ...
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Dumps, backups, logs and the SQLite fallback database.
<FilesMatch "\.(sql|sqlite|bak|bak2|log|zip|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Composer metadata and any *.config.json (installer credentials).
<FilesMatch "^(composer\.(json|lock)|.*\.config\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Directory listings.
Options -Indexes
# --- END hardening ---------------------------------------------------------

# --- BEGIN pretty URLs ------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # /health -> health.php (diagnostics). Kept short so it is easy to type.
    RewriteRule ^health/?$ health.php [L]

    # Block whole directories that FilesMatch cannot reach. This matters when the
    # git clone IS the document root: without it, /.git/config and the rest of the
    # history are downloadable, which hands over the entire source tree.
    RewriteRule ^\.git(/|$) - [F,L]
    RewriteRule ^\.github(/|$) - [F,L]
    RewriteRule (^|/)\.env(\.|$) - [F,L]
</IfModule>
# --- END pretty URLs --------------------------------------------------------
